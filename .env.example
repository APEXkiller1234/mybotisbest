# ── Required ──────────────────────────────────────────────
# Your bot token from https://discord.com/developers/applications
DISCORD_TOKEN=your-bot-token-here

# ── Slash commands ────────────────────────────────────────
# Your server's ID (register /say instantly in this guild;
# leave empty to register globally — can take up to an hour to show).
GUILD_ID=123456789012345678

# ── Commands ──────────────────────────────────────────────
# Prefix for all commands (default: !)
PREFIX=!

# ── Admin access ──────────────────────────────────────────
# Role ID(s) allowed to use commands (comma-separated for multiple roles).
# Leave empty to fall back to the "Administrator" permission.
ADMIN_ROLE_IDS=123456789012345678,987654321098765432

# User ID(s) that always bypass the admin check (comma-separated). Optional.
BOT_OWNER_IDS=123456789012345678

# ── Leaderboard (OPTIONAL: prefer config.json) ────────────
# Images posted by !leaderboard (URL or local path in config.json).
LIFETIME_IMAGE_URL=https://example.com/leaderboard-lifetime.png
MONTHLY_IMAGE_URL=https://example.com/leaderboard-monthly.png

# Roles mentioned in the leaderboard note.
TOP3_ROLE_ID=123456789012345678
TOP10_ROLE_ID=123456789012345678

# ── Channels (OPTIONAL: prefer config.json) ───────────────
# Channel linked by the !mmtos panel ("Get a Manual Middleman here ->").
MM_REQUEST_CHANNEL_ID=123456789012345678

# ── Tickets (OPTIONAL: prefer config.json) ────────────────
# These are fallbacks for the "tickets" section in config.json.
# Category where middleman ticket channels are created.
TICKET_CATEGORY_ID=123456789012345678

# Roles pinged / allowed inside tickets (comma-separated).
STAFF_ROLE_IDS=123456789012345678

# Prefix for ticket channel names (default: mm-).
TICKET_CHANNEL_PREFIX=mm-
